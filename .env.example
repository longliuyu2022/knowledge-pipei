# Node.js >= 22.13.0，开发与生产使用独立端口、数据库和 Cookie。
TONGZHI_HOST=127.0.0.1
TONGZHI_PORT=3033
# TONGZHI_DB_PATH=/absolute/path/tongzhi.sqlite
# TONGZHI_PUBLIC_ORIGIN=https://zhihu.aiimage.icu

# 模型只在明确配置时启用；禁止把任何凭证写入 VITE_ 变量。
TONGZHI_USE_LOCAL_MODEL=false
# TONGZHI_AI_ENABLED=false
# TONGZHI_AI_PROTOCOL=openai
# TONGZHI_AI_BASE_URL=https://your-provider.example/v1
# TONGZHI_AI_MODEL=your-model
# TONGZHI_AI_API_KEY=
# TONGZHI_AI_TIMEOUT_MS=40000
# TONGZHI_AI_JSON_MODE=true
# TONGZHI_AI_DISABLE_THINKING=true
# 或引用服务器私有 JSON：api_key、base_url、model、protocol。
# TONGZHI_AI_CONFIG_FILE=/etc/tongzhi/model.json

# 可选语义向量；未配置时使用明确披露的本地兴趣相似度。
# TONGZHI_EMBEDDING_MODEL=your-embedding-model
# TONGZHI_EMBEDDING_BASE_URL=https://your-provider.example/v1
# TONGZHI_EMBEDDING_API_KEY=

ZHIHU_OAUTH_APP_ID=400
ZHIHU_OAUTH_REDIRECT_URI=https://zhihu.aiimage.icu/auth/callback
# App Key、Access Secret 使用 systemd LoadCredential 或私有文件。
# ZHIHU_OAUTH_APP_KEY_FILE=/etc/tongzhi/zhihu_app_key
# ZHIHU_ACCESS_SECRET_FILE=/etc/tongzhi/zhihu_access_secret

# 独立后台 /admin，普通登录会话无管理权限。
TONGZHI_ADMIN_USERNAME=admin
# TONGZHI_ADMIN_PASSWORD_HASH_FILE=/etc/tongzhi/admin_password_hash
