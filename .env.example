# Node.js >= 22.13.0；生产构建与 API 共用一个端口。
SOUL_HOST=127.0.0.1
SOUL_PORT=3022
# SOUL_DB_PATH=/absolute/path/soulmatch.sqlite
# 上线时设置实际 HTTPS 域名，自动启用 Secure Cookie。
# SOUL_PUBLIC_ORIGIN=https://your-domain.example

# 可选模型。未配置或服务不可用时明确退回可解释的规则分析。
# 默认仅在本机存在 ~/.hermes/config.yaml 时复用其中默认文本模型。
SOUL_USE_LOCAL_MODEL=true
# SOUL_AI_ENABLED=false
# SOUL_AI_PROTOCOL=openai
# SOUL_AI_BASE_URL=https://your-provider.example/v1
# SOUL_AI_MODEL=your-model
# SOUL_AI_API_KEY=
# SOUL_AI_TIMEOUT_MS=40000
# SOUL_AI_JSON_MODE=true
# 当前验证过的 deepseek-v4-flash 可用以下选项关闭思考并加快结构化输出。
# 其他供应商按其实际支持情况设置。
# SOUL_AI_DISABLE_THINKING=true
# 或引用既有服务端 JSON 文件（api_key、base_url、model，可选 protocol/user_agent）：
# SOUL_AI_CONFIG_FILE=/absolute/path/private-model.json

# 可选语义向量。使用提供 /embeddings 的兼容服务；未配置时用主题向量。
# SOUL_EMBEDDING_MODEL=your-embedding-model
# SOUL_EMBEDDING_BASE_URL=https://your-provider.example/v1
# SOUL_EMBEDDING_API_KEY=

# 知乎赛事凭证仅由后端读取。禁止添加 VITE_ 前缀。
# 回调必须与赛事登记完全一致；state 必须得到平台可靠回传。
# ZHIHU_OAUTH_APP_ID=
# ZHIHU_OAUTH_APP_KEY=
# ZHIHU_OAUTH_REDIRECT_URI=https://your-domain.example/api/auth/zhihu/callback
# ZHIHU_ACCESS_SECRET=
