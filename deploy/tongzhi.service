[Unit]
Description=Tongzhi - Question communities and knowledge connections
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/xiangmu/zhihu-tongzhi
ExecStart=/usr/bin/node /root/xiangmu/zhihu-tongzhi/server/index.js
Environment=NODE_ENV=production
Environment=TONGZHI_HOST=127.0.0.1
Environment=TONGZHI_PORT=3033
Environment=TONGZHI_PUBLIC_ORIGIN=https://zhihu.aiimage.icu
Environment=TONGZHI_DB_PATH=/root/xiangmu/zhihu-tongzhi/data/tongzhi.sqlite
Environment=TONGZHI_USE_LOCAL_MODEL=false
Environment=TONGZHI_AI_CONFIG_FILE=%d/model_config
Environment=TONGZHI_AI_DISABLE_THINKING=true
Environment=ZHIHU_OAUTH_APP_ID=400
Environment=ZHIHU_OAUTH_REDIRECT_URI=https://zhihu.aiimage.icu/auth/callback
LoadCredential=model_config:/etc/tongzhi/model.json
LoadCredential=zhihu_app_key:/etc/tongzhi/zhihu_app_key
LoadCredential=zhihu_access_secret:/etc/tongzhi/zhihu_access_secret
LoadCredential=admin_password_hash:/etc/tongzhi/admin_password_hash
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/root/xiangmu/zhihu-tongzhi/data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
