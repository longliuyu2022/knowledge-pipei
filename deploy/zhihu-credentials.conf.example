# Install as /etc/systemd/system/soulmatch.service.d/zhihu.conf.
# Store each secret separately in a root-owned file with mode 0600.
# Add the Access Secret line only after that credential has been supplied.
# Public App ID and callback are read from hackathon.config.json.
[Service]
LoadCredential=zhihu_app_key:/etc/soulmatch/zhihu_app_key
# LoadCredential=zhihu_access_secret:/etc/soulmatch/zhihu_access_secret
