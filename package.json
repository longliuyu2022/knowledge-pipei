{
  "name": "zhihu-tongzhi",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "同知：问题型知识社群、知识画像与深入交流",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "node server/dev.js",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node --watch server/index.js",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node scripts/browser-circles.mjs && node scripts/browser-tongzhi-shell.mjs && node scripts/browser-icebreakers.mjs && node scripts/browser-admin-governance.mjs && node scripts/browser-admin.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs"
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "express": "^5.1.0",
    "json-bigint": "^1.0.0",
