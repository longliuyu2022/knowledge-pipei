    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "playwright": "^1.55.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
